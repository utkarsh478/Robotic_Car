# Place the held object top-down. SPEC §7, §11.6.
geometry_msgs/PoseStamped place_pose    # desired object centre (axis mid-height) when released; frame: odom
---
uint8 NONE=0
uint8 UNREACHABLE=1
uint8 PLANNING_FAILED=2
uint8 EXECUTION_FAILED=3
uint8 RELEASE_NOT_CONFIRMED=4
uint8 TIMEOUT=6
bool success
uint8 error_code
string message
---
string stage                            # "preplace", "descend", "release", "verify", "retract"
