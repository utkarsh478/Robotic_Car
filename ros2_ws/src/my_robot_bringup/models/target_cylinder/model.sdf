<?xml version="1.0"?>
<!-- Mission target (red). Cylinder r 0.025, h 0.15, 0.1 kg, mu 2.0. Single link named "link" (the
     DetachableJoint in P5 refers to it). Model origin on the ground, link centre at z 0.075.
     OdometryPublisher -> /model/<name>/odometry, bridged to /evaluator/* for scoring ONLY. -->
<sdf version="1.8">
  <model name="target_cylinder">
    <link name="link">
      <pose>0 0 0.075 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>2.031250e-04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.031250e-04</iyy><iyz>0</iyz><izz>3.125000e-05</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.15</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.85 0.05 0.05 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
      </visual>
    </link>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>link</robot_base_frame>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
