<?xml version="1.0"?>
<!-- Static grey block 0.3 x 0.3 x 0.5, spawned only by gate scripts to block a path. -->
<sdf version="1.8">
  <model name="test_block">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="collision"><geometry><box><size>0.3 0.3 0.5</size></box></geometry></collision>
      <visual name="visual">
        <geometry><box><size>0.3 0.3 0.5</size></box></geometry>
        <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
