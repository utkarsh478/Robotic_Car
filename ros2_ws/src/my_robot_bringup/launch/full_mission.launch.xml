<?xml version="1.0"?>
<!-- The whole system, SPEC §12 / PHASES P11:
     Gazebo (mission_world, target + distractor spawned, evaluator) -> Nav2 + AMCL -> move_group
     -> pick_place_server -> perception (detectors off until the mission enables them) -> mission.

     ros2 launch my_robot_bringup full_mission.launch.xml headless:=false rviz:=true auto_start:=true
     ros2 launch my_robot_bringup full_mission.launch.xml target_x:=0.9 target_y:=2.5   (T2)
     Without auto_start:  ros2 service call /mission/start std_srvs/srv/Trigger

     Start order: MoveIt and the pick/place server are delayed so Gazebo's controllers and
     /joint_states exist first; the mission's INIT state waits (90 s) for every server anyway.
     This package does not <exec_depend> on the navigation/MoveIt/mission packages:
     my_robot_navigation already depends on my_robot_bringup (cycle). Build the whole workspace. -->
<launch>
  <arg name="target_x" default="3.3"/>       <!-- T1 (3.3, 2.4); T2 (0.9, 2.5); T3 (3.4, -1.2) -->
  <arg name="target_y" default="2.4"/>
  <arg name="auto_start" default="false"/>
  <arg name="headless" default="false"/>
  <arg name="headless_rendering" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="trial_id" default="auto"/>
  <arg name="results_dir" default="auto"/>

  <include file="$(find-pkg-share my_robot_bringup)/launch/mission_sim.launch.xml">
    <arg name="headless" value="$(var headless)"/>
    <arg name="headless_rendering" value="$(var headless_rendering)"/>
    <arg name="rviz" value="false"/>
    <arg name="spawn_objects" value="true"/>
    <arg name="target_x" value="$(var target_x)"/>
    <arg name="target_y" value="$(var target_y)"/>
  </include>

  <include file="$(find-pkg-share my_robot_navigation)/launch/navigation.launch.xml"/>

  <!-- detections in map (SPEC §9); the mission enables each detector when it needs it -->
  <include file="$(find-pkg-share my_robot_perception)/launch/perception.launch.xml">
    <arg name="enabled" value="false"/>
    <arg name="map_frame" value="map"/>
  </include>

  <timer period="10.0">
    <include file="$(find-pkg-share my_robot_moveit_config)/launch/move_group.launch.py"/>
  </timer>
  <timer period="15.0">
    <include file="$(find-pkg-share my_robot_manipulation)/launch/manipulation.launch.py"/>
  </timer>
  <timer period="20.0">
    <include file="$(find-pkg-share my_robot_mission)/launch/mission.launch.xml">
      <arg name="auto_start" value="$(var auto_start)"/>
      <arg name="trial_id" value="$(var trial_id)"/>
      <arg name="results_dir" value="$(var results_dir)"/>
    </include>
  </timer>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="log" if="$(var rviz)"
        args="-d $(find-pkg-share my_robot_navigation)/rviz/nav2.rviz">
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
