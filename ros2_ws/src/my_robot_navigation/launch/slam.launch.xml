<?xml version="1.0"?>
<!-- slam_toolbox online async mapping. On Humble the node is a plain (non-lifecycle) node.
     It is the ONLY map->odom publisher while mapping (SPEC §4): never run it with AMCL. -->
<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="slam_params_file" default="$(find-pkg-share my_robot_navigation)/config/slam_toolbox_params.yaml"/>

  <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox" output="screen">
    <param from="$(var slam_params_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
