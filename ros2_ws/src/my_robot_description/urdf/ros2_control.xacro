<?xml version="1.0"?>
<!-- ros2_control hardware description + Gazebo (Fortress) control plugin. SPEC §5.
     Plugin names are xacro args so they can be overridden without editing this file
     if the installed gz_ros2_control uses different names; gate_p02.sh checks them
     against what is installed in /opt/ros/humble before launching. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_file" default="$(find my_robot_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="gz_hw_plugin"     default="gz_ros2_control/GazeboSimSystem"/>
  <xacro:arg name="gz_plugin_file"   default="libgz_ros2_control-system.so"/>
  <xacro:arg name="gz_plugin_name"   default="gz_ros2_control::GazeboSimROS2ControlPlugin"/>

  <xacro:macro name="velocity_wheel" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max">10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Arm/finger joint: position command (gz_ros2_control turns it into a velocity command
       capped by the joint's URDF effort limit, so a blocked finger squeezes with <= 20 N). -->
  <xacro:macro name="position_joint" params="joint initial">
    <joint name="${joint}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>$(arg gz_hw_plugin)</plugin>
    </hardware>
    <xacro:velocity_wheel joint="left_wheel_joint"/>
    <xacro:velocity_wheel joint="right_wheel_joint"/>
    <xacro:if value="$(arg with_arm)">
      <xacro:position_joint joint="arm_yaw_joint" initial="0.0"/>
      <xacro:position_joint joint="arm_shoulder_joint" initial="0.0"/>
      <xacro:position_joint joint="arm_elbow_joint" initial="0.0"/>
      <xacro:position_joint joint="arm_wrist_joint" initial="0.0"/>
      <xacro:position_joint joint="left_finger_joint" initial="0.04"/>
      <xacro:position_joint joint="right_finger_joint" initial="0.04"/>
    </xacro:if>
  </ros2_control>

  <gazebo>
    <plugin filename="$(arg gz_plugin_file)" name="$(arg gz_plugin_name)">
      <parameters>$(arg controllers_file)</parameters>
      <!-- Humble's diff_drive_controller (use_stamped_vel: false) listens on
           ~/cmd_vel_unstamped and publishes ~/odom. Remap both to the canonical
           names in SPEC §6 so Nav2, teleop and the mission all use /cmd_vel and /odom. -->
      <ros>
        <remapping>/diff_drive_controller/cmd_vel_unstamped:=/cmd_vel</remapping>
        <remapping>/diff_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>

  <!-- Ground-truth pose for gates/evaluator only (SPEC §13, CLAUDE.md rule 4).
       Fortress publishes it on /model/my_robot/odometry; the launch file bridges it to
       /evaluator/robot_odom. No autonomy node may subscribe to it. -->
  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
