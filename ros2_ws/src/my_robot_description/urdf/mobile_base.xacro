<?xml version="1.0"?>
<!-- Differential-drive base. SPEC §3.1.
     base_link origin = midpoint of the drive-wheel axle, 0.075 m above ground.
     base_footprint = its projection on the ground (root of the tree). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="wheel_radius"  value="0.075"/>
  <xacro:property name="wheel_width"   value="0.04"/>
  <xacro:property name="wheel_sep"     value="0.38"/>   <!-- centre-to-centre -->
  <xacro:property name="wheel_mass"    value="0.5"/>

  <xacro:property name="chassis_l"     value="0.50"/>
  <xacro:property name="chassis_w"     value="0.32"/>
  <xacro:property name="chassis_h"     value="0.12"/>
  <xacro:property name="chassis_z"     value="0.05"/>   <!-- box centre above base_link -->
  <xacro:property name="chassis_mass"  value="10.0"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_x"      value="0.20"/>
  <xacro:property name="caster_z"      value="${caster_radius - wheel_radius}"/>  <!-- -0.045: sphere bottom on the ground -->
  <xacro:property name="caster_mass"   value="0.1"/>

  <!-- Root: no geometry, no inertia (KDL warns if the root link has inertia). -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_l}" y="${chassis_w}" z="${chassis_h}">
      <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
    </xacro:box_inertia>
  </link>

  <!-- Drive wheel. Both use axis +y, so a positive joint velocity drives the robot
       forward on both sides (the convention diff_drive_controller expects). -->
  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <!-- Visual-only white stripe on the outer face, so wheel rotation is visible
           in RViz/Gazebo (a plain cylinder looks identical at every angle). -->
      <visual>
        <origin xyz="0 ${reflect * (wheel_width / 2.0 + 0.001)} 0" rpy="0 0 0"/>
        <geometry><box size="${1.6 * wheel_radius} 0.002 0.015"/></geometry>
        <material name="white"/>
      </visual>
      <!-- Collision is a SPHERE of the wheel radius, not the cylinder: with a cylinder,
           DART puts the ground contact on the wheel's inner rim, which shrank the effective
           track to ~0.34 m and made the robot over-rotate by 11 % (P2 gate, 2026-10-20).
           A sphere touches the ground at one point on the wheel's centre plane, so the
           effective separation equals wheel_sep. Visual stays a cylinder. -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}">
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      </xacro:cylinder_inertia>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_sep / 2.0} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10.0" velocity="10.0"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel side="left"  reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>

  <!-- Frictionless ball caster (fixed; Gazebo lumps it into base_link). -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual>
        <geometry><sphere radius="${caster_radius}"/></geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sphere_inertia>
    </link>

    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear"  x="${-caster_x}"/>

</robot>
