<?xml version="1.0"?>
<!-- 4-DOF arm: yaw + shoulder/elbow/wrist pitch. SPEC §3.3.
     Zero configuration: every link points straight up (+z).
     Pitch convention: positive rotation about +y tilts the link toward +x (forward).
     Shoulder joint in base_link: (0.05, 0, 0.21). L2 = 0.28, L3 = 0.24, wrist->tool0 = 0.11. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="arm_mount_x" value="0.05"/>
  <xacro:property name="arm_mount_z" value="0.11"/>   <!-- chassis top in base_link -->
  <xacro:property name="L2" value="0.28"/>
  <xacro:property name="L3" value="0.24"/>

  <!-- One arm link: a box of size (sx, sy, length) whose bottom sits on the joint, so its
       centre is at z = length/2 in the link frame. -->
  <xacro:macro name="arm_link_box" params="name sx sy length mass material">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${sx} ${sy} ${length}"/></geometry>
        <material name="${material}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry><box size="${sx} ${sy} ${length}"/></geometry>
      </collision>
      <xacro:box_inertia m="${mass}" x="${sx}" y="${sy}" z="${length}">
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
      </xacro:box_inertia>
    </link>
  </xacro:macro>

  <xacro:macro name="arm_joint" params="name type axis parent child z lower upper effort velocity">
    <joint name="${name}" type="${type}">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="0 0 ${z}" rpy="0 0 0"/>
      <axis xyz="${axis}"/>
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ===== arm base (fixed to the chassis top) ===== -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.3" r="0.05" h="0.04">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </xacro:cylinder_inertia>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${arm_mount_x} 0 ${arm_mount_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===== joints and links ===== -->
  <xacro:arm_link_box name="shoulder_link" sx="0.06" sy="0.06" length="0.06" mass="0.3" material="dark_grey"/>
  <xacro:arm_joint name="arm_yaw_joint" type="revolute" axis="0 0 1" parent="arm_base_link" child="shoulder_link"
                   z="0.04" lower="-2.9" upper="2.9" effort="10.0" velocity="1.5"/>

  <xacro:arm_link_box name="upper_arm_link" sx="0.04" sy="0.04" length="${L2}" mass="0.5" material="orange"/>
  <xacro:arm_joint name="arm_shoulder_joint" type="revolute" axis="0 1 0" parent="shoulder_link" child="upper_arm_link"
                   z="0.06" lower="-1.0" upper="2.0" effort="20.0" velocity="1.0"/>

  <xacro:arm_link_box name="forearm_link" sx="0.035" sy="0.035" length="${L3}" mass="0.4" material="orange"/>
  <xacro:arm_joint name="arm_elbow_joint" type="revolute" axis="0 1 0" parent="upper_arm_link" child="forearm_link"
                   z="${L2}" lower="-2.6" upper="2.6" effort="12.0" velocity="1.2"/>

  <xacro:arm_link_box name="wrist_link" sx="0.03" sy="0.03" length="0.06" mass="0.15" material="dark_grey"/>
  <xacro:arm_joint name="arm_wrist_joint" type="revolute" axis="0 1 0" parent="forearm_link" child="wrist_link"
                   z="${L3}" lower="-2.0" upper="2.0" effort="5.0" velocity="1.5"/>

</robot>
