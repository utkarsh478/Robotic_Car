<?xml version="1.0"?>
<!-- Top-level robot description. SPEC §3.
     Includes are relative to this file, so it works from src/ and from install/. -->
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- with_arm:=false gives the Phase 1-4 base robot (useful for regression checks). -->
  <xacro:arg name="with_arm" default="true"/>

  <xacro:include filename="common_properties.xacro"/>
  <xacro:include filename="mobile_base.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>

  <xacro:if value="$(arg with_arm)">
    <xacro:include filename="arm.xacro"/>
    <xacro:include filename="gripper.xacro"/>
  </xacro:if>

</robot>
