<?xml version="1.0"?>
<!-- Robot model in RViz only (no Gazebo). Phase 1.
     ros2 launch my_robot_description display.launch.xml
     ros2 launch my_robot_description display.launch.xml rviz:=false gui:=false   (headless gate)

     use_sim_time defaults to false here because no simulator publishes /clock.
     Every launch file that runs with Gazebo sets it to true. -->
<launch>
  <arg name="rviz" default="true"/>
  <arg name="gui" default="true"/>
  <arg name="with_arm" default="true"/>
  <arg name="use_sim_time" default="false"/>

  <let name="rviz_file" value="$(find-pkg-share my_robot_description)/rviz/display.rviz"/>

  <!-- Publishes /robot_description (latched) and TF for every link from /joint_states.
       In Python because Humble XML params YAML-parse the URDF (see rsp.launch.py). -->
  <include file="$(find-pkg-share my_robot_description)/launch/rsp.launch.py">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="with_arm" value="$(var with_arm)"/>
  </include>

  <!-- Publishes /joint_states for the non-fixed joints (the two wheels).
       The GUI version gives sliders; the plain one publishes zeros. -->
  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" name="joint_state_publisher_gui" if="$(var gui)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher" unless="$(var gui)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_file)" if="$(var rviz)" output="log">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
